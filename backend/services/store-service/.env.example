# ============================================================
# store-service · variables de entorno (puerto 3002)
# ============================================================
NODE_ENV=development
PORT=3002
SERVICE_NAME=store-service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearquest_store?schema=public
JWT_SECRET=dev-only-secret-change-me-in-production
# Secreto para tokens de servicio entre microservicios (opcional; si no se define, usa JWT_SECRET)
# INTERNAL_JWT_SECRET=dev-internal-secret-change-me-in-production
# Caducidad de los tokens de usuario (formato ms: 15m, 30d, 12h)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
LOG_LEVEL=info
