# ============================================================
# identity-service · variables de entorno (puerto 3001)
# ============================================================
# Copia este archivo a .env y ajusta los valores locales.
# NUNCA subas el .env real al repositorio.

NODE_ENV=development
PORT=3001
SERVICE_NAME=identity-service

# Base de datos propia del servicio (una base por microservicio).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearquest_identity?schema=public

# --- Autenticación (JWT access + refresh) ---
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Compartidas ---
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
LOG_LEVEL=info
