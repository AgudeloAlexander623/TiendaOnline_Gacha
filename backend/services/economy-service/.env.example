# ============================================================
# economy-service · variables de entorno (puerto 3003)
# ============================================================
NODE_ENV=development
PORT=3003
SERVICE_NAME=economy-service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearquest_economy?schema=public
JWT_SECRET=dev-only-secret-change-me-in-production
# Caducidad de los tokens de usuario (formato ms: 15m, 30d, 12h)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
LOG_LEVEL=info

# Regla de negocio: las monedas ganadas jugando vencen a los 30 días.
EARNED_COINS_TTL_DAYS=30
