# ============================================================
# payments-service · variables de entorno (puerto 3004)
# ============================================================
# Las recargas son SIMULADAS: no se procesa dinero real ni datos de tarjeta.
NODE_ENV=development
PORT=3004
SERVICE_NAME=payments-service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearquest_payments?schema=public
JWT_SECRET=dev-only-secret-change-me-in-production
# Caducidad de los tokens de usuario (formato ms: 15m, 30d, 12h)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
LOG_LEVEL=info

# Proveedor de pago activo: mock | stripe | mercadopago
PAYMENT_PROVIDER=mock
CURRENCY=COP
FRONTEND_URL=http://localhost:5173
