# ============================================================
# GearQuest · Backend (monorepo) · variables de entorno
# ============================================================
# Cada servicio tiene su propio archivo services/<servicio>/.env
# (copia services/<servicio>/.env.example). Este archivo raíz es
# solo una referencia de los valores compartidos y los puertos.
#
# NUNCA subas archivos .env reales al repositorio.
# ============================================================

# --- Puertos por servicio (coinciden con cada services/*/.env.example) ---
# identity-service : 3001
# store-service    : 3002
# economy-service  : 3003
# payments-service : 3004

# --- PostgreSQL local (ver infra/docker/docker-compose.yml) ---
# Un contenedor, una base de datos por servicio:
#   gearquest_identity, gearquest_store, gearquest_economy, gearquest_payments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Valores comunes de los servicios ---
NODE_ENV=development
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
LOG_LEVEL=info

# --- Autenticación (identity-service; estrategia por confirmar) ---
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=8h
