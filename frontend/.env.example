# Variables de entorno frontend (Vite)
# Copiar a .env.local para desarrollo local

# URL base de la API.
#
# Los cuatro microservicios del backend escuchan en puertos distintos
# (identity 3001 · store 3002 · economy 3003 · payments 3004). En desarrollo, el
# proxy de Vite (vite.config.ts) hace de proxy inverso y reparte cada prefijo de
# ruta a su servicio, así que el frontend solo necesita esta ruta.
# En producción, el mismo reparto lo hace el proxy del servidor (ver FR-FE-13 y
# FR-INF-08 en el SRS).
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=GearQuest
