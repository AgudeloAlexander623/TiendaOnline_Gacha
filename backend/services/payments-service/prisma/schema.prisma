// ============================================================
// payments-service · esquema Prisma (gearquest_payments)
// ============================================================
// Dominio: pagos y recargas SIMULADAS (no se procesa dinero real).
// Reglas de negocio:
// - Cada pago es un registro auditable; su estado solo cambia por transiciones válidas.
// - Una recarga acredita monedas compradas (PURCHASED) en el economy-service.
// - `PaymentEvent` guarda el historial de la pasarela (webhooks simulados).
// - `userId` proviene del identity-service; no hay FK entre bases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProvider {
  MOCK
  STRIPE
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum RechargeStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// Paquete de monedas ofrecido en las recargas simuladas.
model CoinPackage {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  coins     Int
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("COP")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recharges Recharge[]

  @@map("coin_packages")
}

model Payment {
  id            String          @id @default(uuid())
  userId        String
  orderId       String?
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("COP")
  provider      PaymentProvider @default(MOCK)
  status        PaymentStatus   @default(PENDING)
  externalId    String?
  failureReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  recharges Recharge[]
  events    PaymentEvent[]
  refunds   Refund[]

  @@index([userId])
  @@map("payments")
}

model Recharge {
  id         String         @id @default(uuid())
  userId     String
  packageId  String
  paymentId  String
  coins      Int
  amountPaid Decimal        @db.Decimal(12, 2)
  currency   String         @default("COP")
  status     RechargeStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  package CoinPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@map("recharges")
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id        String   @id @default(uuid())
  paymentId String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}
